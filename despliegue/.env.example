# Variables del despliegue con Docker Compose (MA-93).
# 1. Copia este archivo en esta misma carpeta con el nombre .env
# 2. Llena las claves vacías. El archivo .env NO se sube al repositorio.

# Base de datos: usa solo letras, números, - y _ en la clave (Docker Compose interpreta el $)
DB_USERNAME=marketplace
DB_PASSWORD=

# Secreto para firmar los tokens: mínimo 32 caracteres. Genera uno en Git Bash con:
#   openssl rand -base64 48
JWT_SECRET=

# Contraseña del usuario "admin" de Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=

# Primer administrador de la aplicación: se crea al arrancar si ambos tienen valor
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagos: "simulado" o "stripe" (con stripe, la clave de prueba sk_test_...)
PAGOS_PROVEEDOR=simulado
STRIPE_SECRET_KEY=

# Correo: con false las notificaciones quedan solo dentro de la aplicación. Para enviarlas por
# Gmail, pon true y la contraseña de aplicación de la cuenta del proyecto (pídela al equipo)
CORREO_ACTIVO=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=inversioneslrmarketplace@gmail.com
MAIL_PASSWORD=
MAIL_FROM=inversioneslrmarketplace@gmail.com

# Puerto de la aplicación en este equipo. Si cambias el 80, CORS_ORIGENES debe llevar el mismo
# puerto, por ejemplo http://localhost:8000
PUERTO_APP=80
CORS_ORIGENES=http://localhost

# Réplicas del backend detrás de Traefik (ADR-008)
REPLICAS_BACKEND=2
