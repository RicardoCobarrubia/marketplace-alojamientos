# Variables de entorno para DESARROLLO.
# 1. Copia este archivo en la misma carpeta con el nombre .env
# 2. Cambia DB_PASSWORD por una clave tuya, solo con letras, números, - y _
#    (Docker Compose interpreta el $ y la clave quedaría distinta para la API).
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Lo leen Spring Boot (application.properties) y Docker Compose (compose.yaml).

DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USERNAME=marketplace
DB_PASSWORD=cambia-esta-clave

MAIL_HOST=localhost
MAIL_PORT=1025

CORS_ORIGENES=http://localhost:5173

# Secreto para firmar los tokens: mínimo 32 caracteres, distinto para cada integrante.
# Puedes generar uno en Git Bash con:  openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres

# Opcional: administrador de prueba que se crea al arrancar (nadie puede registrarse con ese rol)
ADMIN_EMAIL=
ADMIN_PASSWORD=
