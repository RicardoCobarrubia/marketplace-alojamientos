# Variables de entorno para DESARROLLO.
# 1. Copia este archivo en la misma carpeta con el nombre .env
# 2. Cambia DB_PASSWORD por una clave tuya, solo con letras, números, - y _
#    (Docker Compose interpreta el $ y la clave quedaría distinta para la API).
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Lo leen Spring Boot (application.properties) y Docker Compose (compose.yaml).

DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USERNAME=marketplace
DB_PASSWORD=cambia-esta-clave

# Correo. Con estos valores los correos llegan a Mailpit (http://localhost:8025).
# Para enviar correos reales con Gmail:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tu-cuenta@gmail.com
#   MAIL_PASSWORD=la contraseña de aplicación de 16 letras (no la de tu cuenta)
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS=true
#   MAIL_FROM=tu-cuenta@gmail.com
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Remitente de las notificaciones por correo y si se envían (true/false)
MAIL_FROM=no-responder@inversioneslr.com
CORREO_ACTIVO=true

CORS_ORIGENES=http://localhost:5173

# Secreto para firmar los tokens: mínimo 32 caracteres, distinto para cada integrante.
# Puedes generar uno en Git Bash con:  openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres

# Pagos: "simulado" (por defecto) o "stripe". Con stripe, crea una cuenta de Stripe en modo
# prueba y pega aquí tu clave secreta de prueba (empieza por sk_test_). Nunca la subas al repositorio.
PAGOS_PROVEEDOR=simulado
STRIPE_SECRET_KEY=

# Opcional: administrador de prueba que se crea al arrancar (nadie puede registrarse con ese rol)
ADMIN_EMAIL=
ADMIN_PASSWORD=
