# Variables de entorno para DESARROLLO.
# 1. Copia este archivo en la misma carpeta con el nombre .env
# 2. Cambia DB_PASSWORD por una clave tuya.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Lo leen Spring Boot (application.properties) y Docker Compose (compose.yaml).

DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USERNAME=marketplace
DB_PASSWORD=cambia-esta-clave

MAIL_HOST=localhost
MAIL_PORT=1025

CORS_ORIGENES=http://localhost:5173
